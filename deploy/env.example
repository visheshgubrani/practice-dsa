# Production environment for the Oracle ARM64 VPS.
#
#   cp deploy/env.example .env
#   chmod 600 .env
#
# Compose reads this file (deploy/vps-deploy.sh passes --env-file explicitly).
# Keep it on the VPS; it is never copied into the image or committed.
# DATABASE_URL must point at the Compose service name `postgres`, not localhost.

# Everything below works out of the box with the default postgres/postgres
# login; change POSTGRES_PASSWORD and DATABASE_URL together if you rotate it.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dsa_software

# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
# URL-encode characters that are special in a URL (for example @ as %40).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/dsa_software

# The tutor, AI note drafts, and the coach note. Leave empty to keep the
# scripted demo tutor and deterministic coach note.
OPENAI_API_KEY=

# The modified Piston checkout, relative to this directory's parent layout:
# /home/<user>/practice-dsa/.env -> /home/<user>/piston.
PISTON_SOURCE_DIR=../piston
PISTON_NATIVE_IMAGE=piston-native:python-3.12.0

# Loopback port Caddy proxies to. Do not expose this on 0.0.0.0.
# 3000/3001 are taken on the VPS by the academy and cramlify clients.
APP_PORT=3002

# Loopback port for psql/pg_dump on the host. 5470/5482 are taken by the
# cramlify and swingtradervcp Postgres containers.
POSTGRES_PORT=5483

# APP_IMAGE is intentionally absent: the deploy workflow exports the digest of
# the image it just built, and the deploy script passes it to Compose.
