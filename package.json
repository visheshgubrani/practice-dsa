{
  "name": "dsa-software",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-monaco.mjs && next dev",
    "build": "node scripts/sync-monaco.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/harness/*.test.ts lib/piston/*.test.ts lib/runner/*.test.ts lib/problems/*.test.ts lib/practice/*.test.ts lib/ai/*.test.ts lib/chat/**/*.test.ts lib/db/**/*.test.ts",
    "problems:check": "tsx scripts/problems-check.mts",
    "catalog:fetch": "tsx scripts/catalog-fetch.mts",
    "catalog:scaffold": "tsx scripts/catalog-scaffold.mts",
    "catalog:status": "tsx scripts/catalog-status.mts",
    "monaco:sync": "node scripts/sync-monaco.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:seed": "tsx lib/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "piston:up": "docker compose -f docker-compose.dev.yml up -d piston",
    "piston:down": "docker compose -f docker-compose.dev.yml stop piston",
    "piston:logs": "docker compose -f docker-compose.dev.yml logs -f piston",
    "piston:runtimes": "node scripts/piston-runtimes.mjs",
    "piston:check": "tsx scripts/piston-check.mts",
    "piston:latency": "tsx scripts/piston-latency.mts",
    "chat:smoke": "tsx scripts/chat-smoke.mts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.45",
    "@ai-sdk/react": "^4.0.105",
    "@base-ui/react": "^1.8.0",
    "@monaco-editor/react": "4.7.0",
    "@shadcn/react": "^0.3.1",
    "ai": "^7.0.102",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "^1.46.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.4",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2"
}
